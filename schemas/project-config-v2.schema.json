{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesonstone/kit/schemas/project-config-v2.schema.json",
  "title": "Kit Project Configuration v2",
  "type": "object",
  "required": ["schema_version", "registry"],
  "properties": {
    "schema_version": { "const": 2 },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source", "artifacts"],
      "properties": {
        "schema_version": { "const": 1 },
        "source": { "$ref": "#/$defs/source" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["catalog_path"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "catalog_path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" }
      },
      "oneOf": [
        { "required": ["repo"], "not": { "required": ["path"] } },
        { "required": ["path"], "not": { "required": ["repo"] } }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "hash"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "slug", "path", "state"],
      "properties": {
        "kind": { "enum": ["ruleset", "workflow"] },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "description": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "read_policy": { "enum": ["must", "conditional"] },
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "source_repo": { "type": "string" },
        "source_branch": { "type": "string" },
        "source_commit": { "type": "string" },
        "source_path": { "type": "string" },
        "installed_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "state": { "enum": ["managed", "local-custom", "conflict", "missing"] },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    }
  }
}
