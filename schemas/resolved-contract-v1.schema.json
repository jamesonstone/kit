{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesonstone/kit/schemas/resolved-contract-v1.schema.json",
  "title": "Kit Resolved Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state", "project_root", "hints", "registry",
    "routing", "workflows", "rules"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "state": { "enum": ["ready", "blocked"] },
    "project_root": { "type": "string" },
    "hints": { "$ref": "#/$defs/hints" },
    "registry": { "type": "object" },
    "routing": { "type": "array", "items": { "type": "string" } },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/artifact" }
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hints": {
      "type": "object",
      "properties": {
        "feature": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "applicability": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "workflows": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind", "slug", "description", "path", "version", "read_policy",
        "state", "reason"
      ],
      "properties": {
        "kind": { "enum": ["ruleset", "workflow"] },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "read_policy": { "enum": ["must", "conditional"] },
        "state": { "enum": ["managed", "local-custom", "conflict", "missing", "invalid"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_repo": { "type": "string" },
        "source_branch": { "type": "string" },
        "source_commit": { "type": "string" },
        "source_path": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "applicability": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
